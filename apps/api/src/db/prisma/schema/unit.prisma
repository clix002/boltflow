model Unit {
  id          String  @id @default(uuid())
  name        String
  description String?
  color       String  @default("#6366f1")

  boardId String
  board   Board  @relation("BoardUnits", fields: [boardId], references: [id], onDelete: Cascade)
  tasks   Task[] @relation("UnitTasks")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId])
}
