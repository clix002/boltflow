enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PrStatus {
  NONE
  DRAFT
  OPEN
  MERGED
  CLOSED
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  order       Int
  priority    Priority @default(MEDIUM)

  branchName String?
  prNumber   Int?
  prUrl      String?
  prStatus   PrStatus @default(NONE)

  assignees User[] @relation("TaskAssignees")

  columnId String
  column   Column @relation("ColumnTasks", fields: [columnId], references: [id], onDelete: Cascade)

  unitId String?
  unit   Unit?   @relation("UnitTasks", fields: [unitId], references: [id], onDelete: SetNull)

  boltId String?
  bolt   Bolt?   @relation("BoltTasks", fields: [boltId], references: [id], onDelete: SetNull)

  comments Comment[] @relation("TaskComments")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([columnId])
  @@index([unitId])
  @@index([boltId])
}
