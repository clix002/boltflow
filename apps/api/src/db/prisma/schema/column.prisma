model Column {
  id    String @id @default(uuid())
  name  String
  order Int

  unitId String
  unit   Unit   @relation("UnitColumns", fields: [unitId], references: [id], onDelete: Cascade)
  tasks  Task[] @relation("ColumnTasks")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unitId])
}
