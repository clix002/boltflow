model User {
  id          String  @id @default(uuid())
  email       String  @unique
  name        String
  password    String
  avatarUrl   String?
  githubToken String?

  // Relations
  boards   Board[]   @relation("UserBoards")
  comments Comment[] @relation("UserComments")
  assignedTasks Task[] @relation("TaskAssignees")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
