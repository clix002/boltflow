enum BoltStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

model Bolt {
  id       String     @id @default(uuid())
  name     String
  goal     String?
  status   BoltStatus @default(PLANNED)
  startsAt DateTime?
  endsAt   DateTime?

  unitId String
  unit   Unit   @relation("UnitBolts", fields: [unitId], references: [id], onDelete: Cascade)
  tasks  Task[] @relation("BoltTasks")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unitId])
}
