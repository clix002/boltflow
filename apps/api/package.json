{
	"name": "api",
	"scripts": {
		"dev": "bun run --hot src/index.ts",
		"build": "bun build src/index.ts --outdir dist --target bun",
		"check-types": "tsc --noEmit",
		"lint": "biome check src/",
		"test": "bun test --env-file=.env src/",
		"prisma:generate": "bun run --env-file=.env prisma generate",
		"prisma:migrate": "bun run --env-file=.env prisma migrate dev",
		"prisma:seed": "bun run --env-file=.env src/db/prisma/seed.ts",
		"prisma:studio": "bun run --env-file=.env prisma studio",
		"postinstall": "prisma generate"
	},
	"prisma": {
		"seed": "bun run --env-file=.env src/db/prisma/seed.ts"
	},
	"dependencies": {
		"@hono/zod-openapi": "^1.4.0",
		"@prisma/adapter-pg": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"@scalar/hono-api-reference": "^0.10.20",
		"@scrum-board/shared": "workspace:*",
		"es-toolkit": "^1.47.0",
		"hono": "^4.12.23",
		"jose": "^6.2.3",
		"pg": "^8.21.0"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"@types/pg": "^8.20.0",
		"prisma": "^7.8.0"
	}
}
